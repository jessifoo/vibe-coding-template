# Environment and secrets (never commit)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies (all package managers / locations)
node_modules/
**/node_modules/
.pnp
.pnp.js

# Compiled shared libraries (language-agnostic; e.g. native modules, FFI helpers)
*.so

# Build outputs
dist/
build/
out/
.next/
**/.next/
.turbo/
.vercel/
*.tsbuildinfo
coverage/
.nyc_output/
storybook-static/

# Next.js: keep `next-env.d.ts` in version control (do not ignore)

**/*.min.js
**/*.min.css

# Caches and logs
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker and databases
.docker/data/
*.sqlite
*.sqlite3
*.db

# Qdrant data directory
qdrant_data/

# Supabase
.supabase
supabase/.branches
supabase/.temp

# Rust / Cargo (never commit — use `cargo build` locally or in CI)
**/target/
*.rs.bk
**/*.rlib
**/*.prof*

# IDE / local tooling
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~