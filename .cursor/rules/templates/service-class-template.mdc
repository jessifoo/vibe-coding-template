/// Factory for creating item service instances.
pub struct ItemServiceFactory;

impl ItemServiceFactory {
    /// Get the default item service implementation.
    ///
    /// # Errors
    ///
    /// Returns an error if the service cannot be created.
    pub fn get_service() -> Result<Box<dyn ItemService>, AppError> {
        Ok(Box::new(SupabaseItemService::new()?))
    }
}

