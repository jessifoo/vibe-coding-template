#[cfg(test)]
mod tests {
    use super::*;
    use chrono::Utc;
    use uuid::Uuid;

    use parking_lot::Mutex;

    /// Mock implementation for testing.
    pub struct MockItemService {
        items: Mutex<Vec<Item>>,
    }

    impl MockItemService {
        pub fn new() -> Self {
            Self {
                items: Mutex::new(Vec::new()),
            }
        }
    }

    #[async_trait]
    impl ItemService for MockItemService {
        async fn list_for_user(&self, user_id: &str) -> Result<Vec<Item>, AppError> {
            let items = self.items.lock();
            Ok(items
                .iter()
                .filter(|i| i.user_id == user_id)
                .cloned()
                .collect())
        }

        async fn get(&self, id: &str, user_id: &str) -> Result<Option<Item>, AppError> {
            let items = self.items.lock();
            Ok(items
                .iter()
                .find(|i| i.id == id && i.user_id == user_id)
                .cloned())
        }

        async fn create(&self, data: &CreateItemData) -> Result<Item, AppError> {
            let item = Item {
                id: Uuid::new_v4().to_string(),
                user_id: data.user_id.clone(),
                name: data.name.clone(),
                description: data.description.clone(),
                created_at: Utc::now().to_rfc3339(),
                updated_at: Utc::now().to_rfc3339(),
            };
            self.items.lock().push(item.clone());
            Ok(item)
        }

        async fn update(
            &self,
            id: &str,
            user_id: &str,
            data: &UpdateItemData,
        ) -> Result<Item, AppError> {
            let mut items = self.items.lock();
            let item = items
                .iter_mut()
                .find(|i| i.id == id && i.user_id == user_id)
                .ok_or_else(|| AppError::NotFound(id.to_string()))?;

            if let Some(name) = &data.name {
                item.name = name.clone();
            }
            if let Some(desc) = &data.description {
                item.description = Some(desc.clone());
            }
            item.updated_at = Utc::now().to_rfc3339();

            Ok(item.clone())
        }

        async fn delete(&self, id: &str, user_id: &str) -> Result<(), AppError> {
            let mut items = self.items.lock();
            let pos = items
                .iter()
                .position(|i| i.id == id && i.user_id == user_id)
                .ok_or_else(|| AppError::NotFound(id.to_string()))?;
            items.remove(pos);
            Ok(())
        }
    }

    #[tokio::test]
    async fn test_create_and_list() {
        let service = MockItemService::new();
        let user_id = "user-123";

        let item = service
            .create(&CreateItemData {
                user_id: user_id.to_string(),
                name: "Test Item".to_string(),
                description: None,
            })
            .await
            .unwrap();

        assert_eq!(item.name, "Test Item");

        let items = service.list_for_user(user_id).await.unwrap();
        assert_eq!(items.len(), 1);
    }
}
