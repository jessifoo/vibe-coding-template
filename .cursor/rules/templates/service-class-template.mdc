# Rust Service Class Template

Use this template when creating new service classes for external integrations.

## Service with Trait (Recommended for Testability)

```rust
//! Item service for managing items.
//!
//! This module provides the `ItemService` trait and its implementation
//! for interacting with the item storage backend.
//!
//! Dependencies (add to Cargo.toml):
//! ```toml
//! uuid = { version = "1.0", features = ["v4", "serde"] }
//! chrono = { version = "0.4", features = ["serde"] }
//! parking_lot = "0.12"
//! urlencoding = "2.1"
//! ```

use async_trait::async_trait;
use reqwest::Client;
use serde::{Deserialize, Serialize};

use crate::config::SETTINGS;
use crate::models::AppError;

// ============================================================================
// Types
// ============================================================================

/// Item data structure.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Item {
    pub id: String,
    pub user_id: String,
    pub name: String,
    pub description: Option<String>,
    pub created_at: String,
    pub updated_at: String,
}

/// Request to create an item.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct CreateItemData {
    pub user_id: String,
    pub name: String,
    pub description: Option<String>,
}

/// Request to update an item.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct UpdateItemData {
    pub name: Option<String>,
    pub description: Option<String>,
}

// ============================================================================
// Trait Definition
// ============================================================================

/// Trait for item service operations.
///
/// This trait defines the interface for item management,
/// allowing for different implementations (real, mock, etc.).
#[async_trait]
pub trait ItemService: Send + Sync {
    /// List all items for a user.
    ///
    /// # Arguments
    ///
    /// * `user_id` - The ID of the user whose items to list
    ///
    /// # Errors
    ///
    /// Returns an error if the database operation fails.
    async fn list_for_user(&self, user_id: &str) -> Result<Vec<Item>, AppError>;

    /// Get a single item by ID.
    ///
    /// # Arguments
    ///
    /// * `id` - The item ID
    /// * `user_id` - The owning user's ID (for authorization)
    ///
    /// # Errors
    ///
    /// Returns an error if the item doesn't exist or access is denied.
    async fn get(&self, id: &str, user_id: &str) -> Result<Option<Item>, AppError>;

    /// Create a new item.
    ///
    /// # Arguments
    ///
    /// * `data` - The item data to create
    ///
    /// # Errors
    ///
    /// Returns an error if creation fails.
    async fn create(&self, data: &CreateItemData) -> Result<Item, AppError>;

    /// Update an existing item.
    ///
    /// # Arguments
    ///
    /// * `id` - The item ID to update
    /// * `user_id` - The owning user's ID (for authorization)
    /// * `data` - The fields to update
    ///
    /// # Errors
    ///
    /// Returns an error if the item doesn't exist or update fails.
    async fn update(
        &self,
        id: &str,
        user_id: &str,
        data: &UpdateItemData,
    ) -> Result<Item, AppError>;

    /// Delete an item.
    ///
    /// # Arguments
    ///
    /// * `id` - The item ID to delete
    /// * `user_id` - The owning user's ID (for authorization)
    ///
    /// # Errors
    ///
    /// Returns an error if deletion fails.
    async fn delete(&self, id: &str, user_id: &str) -> Result<(), AppError>;
}

// ============================================================================
// Implementation
// ============================================================================

/// Supabase-backed implementation of ItemService.
pub struct SupabaseItemService {
    client: Client,
    base_url: String,
    service_key: String,
}

impl SupabaseItemService {
    /// Create a new Supabase item service.
    ///
    /// # Errors
    ///
    /// Returns an error if the HTTP client cannot be created.
    pub fn new() -> Result<Self, AppError> {
        let client = Client::builder()
            .timeout(std::time::Duration::from_secs(10))
            .build()
            .map_err(|e| AppError::Configuration(format!("HTTP client error: {e}")))?;

        Ok(Self {
            client,
            base_url: format!("{}/rest/v1", SETTINGS.supabase.url),
            service_key: SETTINGS.supabase.service_key.clone(),
        })
    }

    /// Make an authenticated request to Supabase.
    fn auth_headers(&self) -> Vec<(&'static str, String)> {
        vec![
            ("apikey", self.service_key.clone()),
            ("Authorization", format!("Bearer {}", self.service_key)),
        ]
    }

    /// Helper to send a request with auth headers and error handling.
    async fn send_request(
        &self,
        mut request: reqwest::RequestBuilder,
    ) -> Result<reqwest::Response, AppError> {
        // Add auth headers
        for (key, value) in self.auth_headers() {
            request = request.header(key, value);
        }

        // Send request
        let response = request
            .send()
            .await
            .map_err(|e| AppError::ExternalService(format!("Request failed: {e}")))?;

        // Check status
        if !response.status().is_success() {
            let error = response.text().await.unwrap_or_default();
            return Err(AppError::ExternalService(format!("Request failed: {error}")));
        }

        Ok(response)
    }
}

#[async_trait]
impl ItemService for SupabaseItemService {
    async fn list_for_user(&self, user_id: &str) -> Result<Vec<Item>, AppError> {
        let encoded_user_id = urlencoding::encode(user_id);
        let url = format!(
            "{}/items?user_id=eq.{}&select=*&order=created_at.desc",
            self.base_url, encoded_user_id
        );

        let response = self.send_request(self.client.get(&url)).await?;

        response
            .json()
            .await
            .map_err(|e| AppError::ExternalService(format!("Parse error: {e}")))
    }

    async fn get(&self, id: &str, user_id: &str) -> Result<Option<Item>, AppError> {
        let encoded_id = urlencoding::encode(id);
        let encoded_user_id = urlencoding::encode(user_id);
        let url = format!(
            "{}/items?id=eq.{}&user_id=eq.{}&select=*",
            self.base_url, encoded_id, encoded_user_id
        );

        let response = self.send_request(self.client.get(&url)).await?;

        let items: Vec<Item> = response
            .json()
            .await
            .map_err(|e| AppError::ExternalService(format!("Parse error: {e}")))?;

        Ok(items.into_iter().next())
    }

    async fn create(&self, data: &CreateItemData) -> Result<Item, AppError> {
        let url = format!("{}/items", self.base_url);

        let response = self
            .send_request(
                self.client
                    .post(&url)
                    .header("Content-Type", "application/json")
                    .header("Prefer", "return=representation")
                    .json(data),
            )
            .await?;

        let mut items: Vec<Item> = response
            .json()
            .await
            .map_err(|e| AppError::ExternalService(format!("Parse error: {e}")))?;

        items.pop().ok_or_else(|| {
            AppError::ExternalService("Create returned no data".to_string())
        })
    }

    async fn update(
        &self,
        id: &str,
        user_id: &str,
        data: &UpdateItemData,
    ) -> Result<Item, AppError> {
        let encoded_id = urlencoding::encode(id);
        let encoded_user_id = urlencoding::encode(user_id);
        let url = format!(
            "{}/items?id=eq.{}&user_id=eq.{}",
            self.base_url, encoded_id, encoded_user_id
        );

        let response = self
            .send_request(
                self.client
                    .patch(&url)
                    .header("Content-Type", "application/json")
                    .header("Prefer", "return=representation")
                    .json(data),
            )
            .await?;

        let mut items: Vec<Item> = response
            .json()
            .await
            .map_err(|e| AppError::ExternalService(format!("Parse error: {e}")))?;

        items.pop().ok_or_else(|| {
            AppError::NotFound(format!("Item {id} not found"))
        })
    }

    async fn delete(&self, id: &str, user_id: &str) -> Result<(), AppError> {
        let encoded_id = urlencoding::encode(id);
        let encoded_user_id = urlencoding::encode(user_id);
        let url = format!(
            "{}/items?id=eq.{}&user_id=eq.{}",
            self.base_url, encoded_id, encoded_user_id
        );

        self.send_request(self.client.delete(&url)).await?;

        Ok(())
    }
}

