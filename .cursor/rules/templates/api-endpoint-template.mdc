# Rust Axum API Endpoint Template

Use this template when creating new API endpoints.

## Complete Endpoint Example

```rust
//! User profile API endpoints.

use axum::{
    extract::Json,
    http::{header, HeaderMap, StatusCode},
    routing::{get, post, put, delete},
    Router,
};
use serde::{Deserialize, Serialize};
use validator::Validate;

use crate::models::{AppError, UserProfile};
use crate::services::supabase::SupabaseAuthService;

/// Create the router for this module.
pub fn router() -> Router {
    Router::new()
        .route("/", get(list_items).post(create_item))
        .route("/:id", get(get_item).put(update_item).delete(delete_item))
}

// ============================================================================
// Request/Response Types
// ============================================================================

/// Request to create a new item.
#[derive(Debug, Clone, Deserialize, Validate)]
pub struct CreateItemRequest {
    /// Item name (1-100 characters)
    #[validate(length(min = 1, max = 100, message = "Name must be 1-100 characters"))]
    pub name: String,

    /// Optional description
    #[validate(length(max = 1000, message = "Description too long"))]
    pub description: Option<String>,
}

/// Request to update an item.
#[derive(Debug, Clone, Deserialize, Validate)]
pub struct UpdateItemRequest {
    /// Updated name
    #[validate(length(min = 1, max = 100))]
    pub name: Option<String>,

    /// Updated description
    #[validate(length(max = 1000))]
    pub description: Option<String>,
}

/// Response containing an item.
#[derive(Debug, Clone, Serialize)]
pub struct ItemResponse {
    pub id: String,
    pub name: String,
    pub description: Option<String>,
    pub created_at: String,
    pub updated_at: String,
}

/// Response containing a list of items.
#[derive(Debug, Clone, Serialize)]
pub struct ItemListResponse {
    pub items: Vec<ItemResponse>,
    pub total: usize,
}

// ============================================================================
// Endpoint Handlers
// ============================================================================

/// List all items for the authenticated user.
#[axum::debug_handler]
async fn list_items(
    headers: HeaderMap,
) -> Result<Json<ItemListResponse>, AppError> {
    // 1. Authenticate
    let user = authenticate(&headers).await?;

    tracing::info!(user_id = %user.id, "Listing items");

    // 2. Fetch from service
    let service = ItemService::new()?;
    let items = service.list_for_user(&user.id).await?;

    // 3. Return response
    Ok(Json(ItemListResponse {
        total: items.len(),
        items,
    }))
}

/// Get a single item by ID.
#[axum::debug_handler]
async fn get_item(
    headers: HeaderMap,
    axum::extract::Path(id): axum::extract::Path<String>,
) -> Result<Json<ItemResponse>, AppError> {
    // 1. Authenticate
    let user = authenticate(&headers).await?;

    tracing::info!(user_id = %user.id, item_id = %id, "Getting item");

    // 2. Fetch from service
    let service = ItemService::new()?;
    let item = service.get(&id, &user.id).await?
        .ok_or_else(|| AppError::NotFound(format!("Item {id} not found")))?;

    // 3. Return response
    Ok(Json(item))
}

/// Create a new item.
#[axum::debug_handler]
async fn create_item(
    headers: HeaderMap,
    Json(request): Json<CreateItemRequest>,
) -> Result<(StatusCode, Json<ItemResponse>), AppError> {
    // 1. Authenticate
    let user = authenticate(&headers).await?;

    // 2. Validate request
    request.validate().map_err(AppError::from)?;

    tracing::info!(
        user_id = %user.id,
        item_name = %request.name,
        "Creating item"
    );

    // 3. Create via service
    let service = ItemService::new()?;
    let item = service.create(&user.id, &request).await?;

    tracing::info!(
        user_id = %user.id,
        item_id = %item.id,
        "Item created"
    );

    // 4. Return 201 Created with response
    Ok((StatusCode::CREATED, Json(item)))
}

/// Update an existing item.
#[axum::debug_handler]
async fn update_item(
    headers: HeaderMap,
    axum::extract::Path(id): axum::extract::Path<String>,
    Json(request): Json<UpdateItemRequest>,
) -> Result<Json<ItemResponse>, AppError> {
    // 1. Authenticate
    let user = authenticate(&headers).await?;

    // 2. Validate request
    request.validate().map_err(AppError::from)?;

    tracing::info!(
        user_id = %user.id,
        item_id = %id,
        "Updating item"
    );

    // 3. Update via service
    let service = ItemService::new()?;
    let item = service.update(&id, &user.id, &request).await?;

    // 4. Return response
    Ok(Json(item))
}

/// Delete an item.
#[axum::debug_handler]
async fn delete_item(
    headers: HeaderMap,
    axum::extract::Path(id): axum::extract::Path<String>,
) -> Result<StatusCode, AppError> {
    // 1. Authenticate
    let user = authenticate(&headers).await?;

    tracing::info!(
        user_id = %user.id,
        item_id = %id,
        "Deleting item"
    );

    // 2. Delete via service
    let service = ItemService::new()?;
    service.delete(&id, &user.id).await?;

    // 3. Return 204 No Content
    Ok(StatusCode::NO_CONTENT)
}

// ============================================================================
// Helper Functions
// ============================================================================

/// Authenticate user from request headers.
async fn authenticate(headers: &HeaderMap) -> Result<UserProfile, AppError> {
    let token = extract_bearer_token(headers)?;
    let auth_service = SupabaseAuthService::new()?;
    auth_service.get_user(&token).await
}

/// Extract bearer token from Authorization header.
fn extract_bearer_token(headers: &HeaderMap) -> Result<String, AppError> {
    let auth_header = headers
        .get(header::AUTHORIZATION)
        .and_then(|v| v.to_str().ok())
        .ok_or_else(|| AppError::Unauthorized("Missing Authorization header".to_string()))?;

    auth_header
        .strip_prefix("Bearer ")
        .or_else(|| auth_header.strip_prefix("bearer "))
        .map(ToString::to_string)
        .ok_or_else(|| AppError::Unauthorized("Invalid Authorization format".to_string()))
}
```

## Registration

Add to `src/api/mod.rs`:

```rust
pub mod items;  // Add this

pub fn create_router() -> Router {
    Router::new()
        .nest("/auth", auth::router())
        .nest("/items", items::router())  // Add this
        // ...
}
```

## Checklist

- [ ] Request types have `#[derive(Deserialize, Validate)]`
- [ ] Response types have `#[derive(Serialize)]`
- [ ] All endpoints have `#[axum::debug_handler]`
- [ ] Authentication checked on all protected endpoints
- [ ] Request validation performed
- [ ] Logging added with context
- [ ] Proper HTTP status codes used
- [ ] Error cases return `AppError`
